# Copy this file to .env and fill in your values.  NEVER commit .env to GitHub.

# PostgreSQL connection string
# Local example:  postgresql://postgres:postgres@localhost:5432/steakz?schema=public
# Render/Neon:    paste the "External/Internal Database URL" from your provider
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/steakz?schema=public"

# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Admin account created automatically on the server's FIRST start
ADMIN_EMAIL="admin@steakz.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="System Admin"

# On the first start with an EMPTY database, automatically create the 7 branches and
# every role (branch managers, chefs, waiters/cashiers, HQ, customers) with demo data.
SEED_DEMO_DATA=true

# Frontend URL(s) allowed to call the API (comma-separated), or * for any
CORS_ORIGIN="*"

PORT=5000
